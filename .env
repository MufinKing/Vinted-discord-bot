# --- Obligatoire ---
# Webhook Discord (Paramètres du salon > Intégrations > Webhooks). SECRET : ne le publiez jamais.
DISCORD_WEBHOOK_URL=

# --- Source e-mail (alertes Leboncoin) : boîte Gmail DÉDIÉE ---
GMAIL_USER=
# Mot de passe d'application Google (validation en 2 étapes requise), 16 lettres. SECRET.
GMAIL_APP_PASSWORD=
# Expéditeurs des alertes, séparés par des virgules (un fragment d'adresse suffit)
ALERT_FROM=leboncoin
# Mots d'objet à ignorer (mails transactionnels : reçus, codes, messages...), expression régulière
# SKIP_SUBJECT=reçu|code|confirmation|message|offre|welcome|bienvenue|commande|vérification|verification

# --- Sources actives : mail, vinted (défaut : les deux) ---
SOURCES=mail,vinted
# Secondes entre deux relevés de la boîte mail
POLL_SECONDS=120
# Secondes entre deux relevés d'une même recherche Vinted (minimum imposé : 60)
VINTED_POLL_SECONDS=120

# --- Calcul de marge ---
# Marge nette minimale (en €) pour déclencher une alerte
MIN_NET=10
# Prix d'achat maximum par article (en €), pour protéger votre capital
MAX_PER_ITEM=60
# Commission de vente : 0 pour un vendeur particulier, 0.05 si vendeur Vinted Pro (à vérifier)
SELL_FEE=0
# Part du port de VENTE à votre charge : 0 = l'acheteur paie (cas par défaut), 1 = vous payez tout
SELL_SHIP_SHARE=0
# 1 = ignorer les annonces Leboncoin sans "Livraison possible" ; 0 = tout garder
REQUIRE_DELIVERY=1
